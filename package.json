{
  "name": "goose-code-review",
  "version": "1.0.1",
  "description": "AI-assisted code review tool with local web UI - View, analyze and review code with AI-powered insights",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "build:packages": "npm run build -w @code-review-goose/analysis-types && npm run build -w @code-review-goose/analysis-utils && npm run build -w @code-review-goose/analysis-core && npm run build -w @code-review-goose/analysis-adapter-vscode && npm run build -w goose-code-review-vscode",
    "clean": "npm run clean --workspaces --if-present && find packages -name 'tsconfig.tsbuildinfo' -delete && rm -rf node_modules",
    "lint": "eslint . --ext .ts,.vue",
    "format": "prettier --write \"**/*.{ts,vue,json,md}\"",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-vue": "^9.18.0",
    "prettier": "^3.1.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-java": "^0.21.0",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.21.2",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "code-review",
    "ai",
    "cli",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kuochunchang/code-review-goose.git"
  },
  "bugs": {
    "url": "https://github.com/kuochunchang/code-review-goose/issues"
  },
  "homepage": "https://github.com/kuochunchang/code-review-goose#readme",
  "author": "KCC",
  "license": "MIT",
  "dependencies": {
    "glob": "^12.0.0"
  }
}
