  "author": "KCC",
  "license": "MIT",
  "dependencies": {
    "@code-review-goose/analysis-types": "*",
    "@octokit/rest": "^22.0.1",
    "gpt-3-encoder": "^1.1.4",
    "simple-git": "^3.25.0",
    "sonarqube-scanner": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "typescript": "^5.3.2",
    "vitest": "^1.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
