{
  "name": "@code-review-goose/git-analyzer",
  "version": "0.1.0",
  "description": "Git change analysis with SonarQube and AI integration",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
