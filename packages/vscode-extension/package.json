{
  "name": "goose-code-review-vscode",
  "displayName": "Goose Code Review",
  "description": "AI-assisted code review with UML diagram generation in VS Code",
  "version": "0.1.0",
  "publisher": "kuochunchang",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "code-review",
    "uml",
    "class-diagram",
    "sequence-diagram",
    "ai"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:java",
    "onLanguage:python"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gooseCodeReview.openAnalysisPanel",
        "title": "Open Analysis Panel",
        "category": "Goose Code Review",
        "icon": "$(beaker)"
      },
      {
        "command": "gooseCodeReview.openUMLPanel",
        "title": "Open UML Panel",
        "category": "Goose Code Review",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "gooseCodeReview.generateClassDiagram",
        "title": "Generate Class Diagram",
        "category": "Goose Code Review"
      },
      {
        "command": "gooseCodeReview.generateSequenceDiagram",
        "title": "Generate Sequence Diagram",
        "category": "Goose Code Review"
      },
      {
        "command": "gooseCodeReview.analyzeWorkingDirectory",
        "title": "Analyze Working Directory Changes",
        "category": "Goose Code Review",
        "icon": "$(git-commit)"
      },
      {
        "command": "gooseCodeReview.analyzeBranch",
        "title": "Analyze Branch Comparison",
        "category": "Goose Code Review",
        "icon": "$(git-compare)"
      },
      {
        "command": "gooseCodeReview.analyzePullRequest",
        "title": "Analyze Pull Request",
        "category": "Goose Code Review",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "gooseCodeReview.openGitChangePanel",
        "title": "Open Git Change Analysis",
        "category": "Goose Code Review",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "gooseCodeReview.showGitAnalysisMenu",
        "title": "Git Analysis Menu",
        "category": "Goose Code Review",
        "icon": {
          "light": "resources/goose-icon-dark.svg",
          "dark": "resources/goose-icon-light.svg"
        }
      },
      {
        "command": "gooseCodeReview.sonarqube.addConnection",
        "title": "Add SonarQube Connection",
        "category": "Goose Code Review",
        "icon": "$(add)"
      },
      {
        "command": "gooseCodeReview.sonarqube.bindProject",
        "title": "Bind to SonarQube Project",
        "category": "Goose Code Review",
        "icon": "$(link)"
      },
      {
        "command": "gooseCodeReview.sonarqube.testConnection",
        "title": "Test SonarQube Connection",
        "category": "Goose Code Review",
        "icon": "$(check)"
      },
      {
        "command": "gooseCodeReview.sonarqube.diagnose",
        "title": "Diagnose SonarQube Integration",
        "category": "Goose Code Review",
        "icon": "$(pulse)"
      },
      {
        "command": "gooseCodeReview.analyzeProjectSonarQube",
        "title": "Analyze Project with SonarQube",
        "category": "Goose Code Review",
        "icon": "$(search)"
      }
    ],
    "keybindings": [
      {
        "command": "gooseCodeReview.openAnalysisPanel",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorLangId == typescript || editorLangId == javascript || editorLangId == typescriptreact || editorLangId == javascriptreact || editorLangId == java || editorLangId == python"
      },
      {
        "command": "gooseCodeReview.openUMLPanel",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u",
        "when": "editorLangId == typescript || editorLangId == javascript || editorLangId == typescriptreact || editorLangId == javascriptreact || editorLangId == java || editorLangId == python"
      },
      {
        "command": "gooseCodeReview.openGitChangePanel",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      },
      {
        "command": "gooseCodeReview.showGitAnalysisMenu",
        "key": "ctrl+shift+g ctrl+shift+m",
        "mac": "cmd+shift+g cmd+shift+m"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "editorLangId == typescript || editorLangId == javascript || editorLangId == typescriptreact || editorLangId == javascriptreact || editorLangId == java || editorLangId == python",
          "command": "gooseCodeReview.openAnalysisPanel",
          "group": "navigation"
        },
        {
          "when": "editorLangId == typescript || editorLangId == javascript || editorLangId == typescriptreact || editorLangId == javascriptreact || editorLangId == java || editorLangId == python",
          "command": "gooseCodeReview.openUMLPanel",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "when": "editorLangId == typescript || editorLangId == javascript || editorLangId == typescriptreact || editorLangId == javascriptreact || editorLangId == java || editorLangId == python",
          "command": "gooseCodeReview.openAnalysisPanel",
          "group": "gooseCodeReview@0"
        },
        {
          "when": "editorLangId == typescript || editorLangId == javascript || editorLangId == typescriptreact || editorLangId == javascriptreact || editorLangId == java || editorLangId == python",
          "command": "gooseCodeReview.openUMLPanel",
          "group": "gooseCodeReview@1"
        },
        {
          "when": "editorLangId == typescript || editorLangId == javascript || editorLangId == typescriptreact || editorLangId == javascriptreact || editorLangId == java || editorLangId == python",
          "command": "gooseCodeReview.generateClassDiagram",
          "group": "gooseCodeReview@2"
        },
        {
          "when": "editorLangId == typescript || editorLangId == javascript || editorLangId == typescriptreact || editorLangId == javascriptreact || editorLangId == java || editorLangId == python",
          "command": "gooseCodeReview.generateSequenceDiagram",
          "group": "gooseCodeReview@3"
        }
      ],
      "scm/title": [
        {
          "command": "gooseCodeReview.showGitAnalysisMenu",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "Goose Code Review",
      "properties": {
        "gooseCodeReview.aiProvider": {
          "type": "string",
          "default": "openai",
          "enum": [
            "openai",
            "gemini"
          ],
          "enumDescriptions": [
            "Use OpenAI or OpenAI-compatible APIs (default)",
            "Use Google Gemini models via the Generative Language API"
          ],
          "description": "Select which AI provider powers code analysis",
          "scope": "application"
        },
        "gooseCodeReview.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API Key for code analysis (prefer using Secret Storage for security)",
          "scope": "application"
        },
        "gooseCodeReview.analysisModel": {
          "type": "string",
          "default": "gpt-4o",
          "enum": [
            "gpt-4o",
            "gpt-4o-mini",
            "gpt-4o-2024-11-20",
            "chatgpt-4o-latest",
            "gpt-4-turbo",
            "gpt-4",
            "o1",
            "o1-mini",
            "o1-preview",
            "gpt-3.5-turbo"
          ],
          "enumDescriptions": [
            "GPT-4o - Latest multimodal model (recommended)",
            "GPT-4o Mini - Faster and cheaper version",
            "GPT-4o - November 2024 snapshot",
            "GPT-4o - Always the latest version",
            "GPT-4 Turbo - Previous generation",
            "GPT-4 - Classic model",
            "o1 - Advanced reasoning model (no temperature control)",
            "o1-mini - Faster reasoning model (no temperature control)",
            "o1-preview - Preview reasoning model (no temperature control)",
            "GPT-3.5 Turbo - Legacy model"
          ],
          "description": "OpenAI model to use for code analysis (or custom model name when using custom API)",
          "scope": "application"
        },
        "gooseCodeReview.useCustomApi": {
          "type": "boolean",
          "default": false,
          "description": "Use custom OpenAI-compatible API instead of official OpenAI",
          "scope": "application"
        },
        "gooseCodeReview.customApiUrl": {
          "type": "string",
          "default": "",
          "description": "Custom OpenAI-compatible API base URL (e.g., https://llm.webcomm.com.tw/v1)",
          "scope": "application"
        },
        "gooseCodeReview.customModelName": {
          "type": "string",
          "default": "",
          "description": "Custom model name to use when custom API is enabled (e.g., gpt-4o, claude-3-5-sonnet, etc.)",
          "scope": "application"
        },
        "gooseCodeReview.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Gemini API Key for code analysis (prefer using Secret Storage for security)",
          "scope": "application"
        },
        "gooseCodeReview.geminiModel": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "enum": [
            "gemini-3-pro-preview",
            "gemini-2.5-pro",
            "gemini-2.5-flash",
            "gemini-2.5-flash-lite",
            "gemini-2.0-flash",
            "gemini-2.0-flash-lite"
          ],
          "enumDescriptions": [
            "Gemini 3 Pro - Most powerful multimodal model (preview)",
            "Gemini 2.5 Pro - Advanced thinking mode for complex problems",
            "Gemini 2.5 Flash - Best price-performance ratio (recommended)",
            "Gemini 2.5 Flash-Lite - Fastest, most cost-efficient",
            "Gemini 2.0 Flash - Stable workhorse model",
            "Gemini 2.0 Flash-Lite - Cost-efficient alternative"
          ],
          "description": "Gemini model to use for code analysis",
          "scope": "application"
        },
        "gooseCodeReview.analysisDepth": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 5,
          "description": "Depth of relationship analysis (1-5)"
        },
        "gooseCodeReview.analysisMode": {
          "type": "string",
          "default": "focused",
          "enum": [
            "focused",
            "comprehensive"
          ],
          "enumDescriptions": [
            "Analyze only direct relationships",
            "Analyze all related classes and dependencies"
          ],
          "description": "Analysis mode for UML generation"
        },
        "gooseCodeReview.showPrivateMembers": {
          "type": "boolean",
          "default": false,
          "description": "Include private members in class diagrams"
        },
        "gooseCodeReview.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh diagrams when file changes"
        },
        "gooseCodeReview.sonarqube.connections": {
          "type": "array",
          "default": [],
          "markdownDescription": "Configure SonarQube/SonarCloud connections. Each connection requires a unique connectionId and serverUrl.",
          "scope": "application",
          "items": {
            "type": "object",
            "required": [
              "connectionId",
              "serverUrl"
            ],
            "properties": {
              "connectionId": {
                "type": "string",
                "description": "Unique connection identifier (e.g., 'local-sonarqube', 'sonarcloud')"
              },
              "serverUrl": {
                "type": "string",
                "description": "SonarQube server URL (e.g., http://localhost:9000 or https://sonarcloud.io)"
              },
              "organizationKey": {
                "type": "string",
                "description": "Organization key (required for SonarCloud)"
              },
              "disableTelemetry": {
                "type": "boolean",
                "default": false,
                "description": "Disable telemetry for this connection"
              }
            }
          }
        },
        "gooseCodeReview.sonarqube.projectBinding": {
          "type": "object",
          "default": null,
          "markdownDescription": "Bind workspace to a SonarQube project. Set connectionId and projectKey to enable SonarQube analysis.",
          "scope": "resource",
          "properties": {
            "connectionId": {
              "type": "string",
              "description": "Connection ID from sonarqube.connections"
            },
            "projectKey": {
              "type": "string",
              "description": "SonarQube project key (unique identifier)"
            },
            "projectName": {
              "type": "string",
              "description": "Project display name (optional)"
            }
          }
        },
        "gooseCodeReview.sonarqube.timeout": {
          "type": "number",
          "default": 3000,
          "minimum": 1000,
          "maximum": 30000,
          "description": "SonarQube connection timeout in milliseconds",
          "scope": "application"
        },
        "gooseCodeReview.sonarqube.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable SonarQube integration for Git change analysis",
          "scope": "application"
        },
        "gooseCodeReview.gitAnalysis.mode": {
          "type": "string",
          "default": "sonarqube-only",
          "enum": [
            "sonarqube-only"
          ],
          "enumDescriptions": [
            "SonarQube Only: Use only SonarQube analysis"
          ],
          "description": "Git change analysis mode (SonarQube only)",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "watch": "tsc --watch",
    "package": "vsce package",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@code-review-goose/analysis-adapter-vscode": "*",
    "@code-review-goose/analysis-core": "*",
    "@code-review-goose/analysis-types": "*",
    "@code-review-goose/git-analyzer": "*",
    "@google/generative-ai": "^0.24.1",
    "openai": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.2",
    "vitest": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kuochunchang/code-review-goose.git"
  },
  "bugs": {
    "url": "https://github.com/kuochunchang/code-review-goose/issues"
  },
  "homepage": "https://github.com/kuochunchang/code-review-goose#readme",
  "author": "KCC",
  "license": "MIT"
}