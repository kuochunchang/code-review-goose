# Files to exclude from VS Code extension package

# Source files
src/
tsconfig.json
.vscode/
.vscode-test/

# Build artifacts
**/*.map
*.vsix

# Dependencies
node_modules/
.npm

# Tests
**/__tests__/
**/*.test.ts
**/*.spec.ts
**/test/
vitest.config.ts
coverage/

# Documentation
.github/
docs/
../docs/
../../docs/

# Git
.git/
.gitignore
.gitattributes
../.git/
../../.git/

# Other
.DS_Store
Thumbs.db
*.log
.eslintrc.*
.prettierrc.*
*.md.backup

# Monorepo files - exclude everything from parent directories
../*
../../*
!../analysis-adapter-vscode/dist/
!../analysis-core/dist/
!../analysis-parser-common/dist/
!../analysis-parser-java/dist/
!../analysis-parser-python/dist/
!../analysis-parser-typescript/dist/
!../analysis-types/dist/
!../analysis-utils/dist/
!../git-analyzer/dist/
# Explicitly exclude problematic directories
../../.changeset/
../../.dockerignore
../../docker-compose.yml
../../.github/
../../.prettierrc
../../AGENT.md
../../CLAUDE.md
../../README.md
../../LICENSE
../../package.json
../../package-lock.json
../../tsconfig.base.json
../../tsconfig.json
