{
  "name": "@code-review-goose/analysis-adapter-vscode",
  "version": "0.1.0",
  "description": "VS Code file system adapter for code analysis engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "vscode",
    "file-system",
    "adapter",
    "code-analysis"
  ],
  "author": "KCC",
  "license": "MIT",
  "dependencies": {
    "@code-review-goose/analysis-types": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.2",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
